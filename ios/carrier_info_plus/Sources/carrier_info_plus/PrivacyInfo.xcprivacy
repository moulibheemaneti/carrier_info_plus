<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  Nothing is collected: every value is read on device, returned to the
	  calling app and never transmitted by this package. The app that embeds
	  it may well collect something, and declares that in its own manifest.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!--
	  Empty by design. CoreTelephony is not on Apple's required-reason API
	  list, so no declaration is owed for it.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
